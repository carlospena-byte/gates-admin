{
  "name": "gates-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev:vite-only": "vite",
    "dev:functions-only": "supabase functions serve --workdir .",
    "dev": "bash scripts/dev.sh development",
    "dev:local": "npm run dev",
    "dev:staging": "bash scripts/dev.sh staging",
    "dev:prod": "bash scripts/dev.sh production",
    "stop:local": "bash scripts/stop.sh",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:reset": "supabase db reset --workdir .",
    "seed:users": "bash scripts/seed-dev-users.sh",
    "types": "supabase gen types typescript --local > src/types/supabase.ts",
    "build": "tsc -b && vite build",
    "build:local": "npm run build",
    "build:staging": "vite build --mode staging",
    "build:prod": "npm run build",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "preview:local": "npm run preview",
    "preview:staging": "vite preview --mode staging"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.89.0",
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
