VITE_APP_ENV=development
VITE_APP_URL=http://127.0.0.1:5173

# Local Supabase (via `supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:64321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: enables Google Map click-to-place marker in signup
VITE_GOOGLE_MAPS_API_KEY=

# Local email testing: send-invitation delivers here instead of Resend
# (same Mailpit container Supabase Auth already uses). View at
# http://127.0.0.1:8025 (see docker-compose.mailpit.yml).
SMTP_HOST=gates-admin-mailpit
SMTP_PORT=1025

# Optional (used by Edge Functions in staging/prod, when SMTP_HOST above is unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# send-visit-notification: FastLane link base (same value as VITE_APP_URL) and
# Twilio credentials for SMS/WhatsApp. Left empty locally — the function
# reports notificationSent: false with a clear error instead of failing.
PUBLIC_APP_URL=http://127.0.0.1:5173
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
