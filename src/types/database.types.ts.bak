// ============================================================================
// Helper Types for Easier Usage
// ============================================================================

export type Tables<T extends keyof Database['public']['Tables']> = Database['public']['Tables'][T]['Row']
export type TablesInsert<T extends keyof Database['public']['Tables']> = Database['public']['Tables'][T]['Insert']
export type TablesUpdate<T extends keyof Database['public']['Tables']> = Database['public']['Tables'][T]['Update']

// Specific table types
export type Profile = Tables<'profiles'>
export type Residential = Tables<'residentials'>
export type ResidentialUser = Tables<'residential_users'>
export type Unit = Tables<'units'>
export type UnitMember = Tables<'unit_members'>
export type Amenity = Tables<'amenities'>
export type AmenityBooking = Tables<'amenity_bookings'>

// Insert types
export type InsertProfile = TablesInsert<'profiles'>
export type InsertResidential = TablesInsert<'residentials'>
export type InsertResidentialUser = TablesInsert<'residential_users'>
export type InsertUnit = TablesInsert<'units'>
export type InsertUnitMember = TablesInsert<'unit_members'>
export type InsertAmenity = TablesInsert<'amenities'>
export type InsertAmenityBooking = TablesInsert<'amenity_bookings'>

// Update types
export type UpdateProfile = TablesUpdate<'profiles'>
export type UpdateResidential = TablesUpdate<'residentials'>
export type UpdateResidentialUser = TablesUpdate<'residential_users'>
export type UpdateUnit = TablesUpdate<'units'>
export type UpdateUnitMember = TablesUpdate<'unit_members'>
export type UpdateAmenity = TablesUpdate<'amenities'>
export type UpdateAmenityBooking = TablesUpdate<'amenity_bookings'>
